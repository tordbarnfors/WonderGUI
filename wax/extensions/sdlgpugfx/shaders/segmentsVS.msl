#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_CanvasInfo
{
    float2 canvasScale;
    float2 _textureSize;
    uint flags;
    uint blurOfs;
    uint edgemapEdges;
    uint edgemapPitch;
};

struct type_StructuredBuffer_v4float
{
    float4 _m0[1];
};

struct main0_out
{
    float4 out_var_COLOR [[user(locn0)]];
    float2 out_var_TEXCOORD0 [[user(locn1)]];
    uint2 out_var_TEXCOORD1 [[user(locn2)]];
    float2 out_var_TEXCOORD2 [[user(locn3)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float2 in_var_POSITION [[attribute(0)]];
    uint in_var_COLOROFS [[attribute(1)]];
    uint in_var_EXTRASOFS [[attribute(2)]];
    float2 in_var_TEXCOORD0 [[attribute(3)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_CanvasInfo& CanvasInfo [[buffer(0)]], const device type_StructuredBuffer_v4float& colors [[buffer(3)]], const device type_StructuredBuffer_v4float& extras [[buffer(4)]])
{
    main0_out out = {};
    out.gl_Position = float4((in.in_var_POSITION.x * CanvasInfo.canvasScale.x) - 1.0, 1.0 - (in.in_var_POSITION.y * CanvasInfo.canvasScale.y), 0.0, 1.0);
    out.out_var_COLOR = colors._m0[in.in_var_COLOROFS];
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD0;
    out.out_var_TEXCOORD1 = uint2(extras._m0[in.in_var_EXTRASOFS].xy);
    out.out_var_TEXCOORD2 = extras._m0[in.in_var_EXTRASOFS + 1u].xy;
    return out;
}

